# Copy this file to .env and fill in real values. .env is gitignored and never committed.

# Optional. If set, bug status changes and comments post an alert to this Discord webhook.
# Leave unset to disable Discord alerts (the app works fine without it).
DISCORD_WEBHOOK_URL=

# Optional. Port the Express server listens on. Render (and most hosts) set this
# automatically — you only need it for local overrides.
PORT=5000
